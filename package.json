{
  "name": "gizmodata-hardcharger-datasource",
  "version": "1.0.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --maxWorkers 4",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"dev/**/*.ts\"",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "build:backend": "go run github.com/magefile/mage -v buildAll",
    "test:backend": "go test ./pkg/...",
    "screenshots": "playwright test -c dev/screenshots/playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"dev/**/*.ts\""
  },
  "author": "GizmoData",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^4.0.0",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.3.1",
    "@grafana/i18n": "13.3.1",
    "@grafana/runtime": "13.3.1",
    "@grafana/ui": "13.3.1",
    "@grafana/schema": "13.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "npm@11.20.0",
  "description": "Hardcharger data source plugin for Grafana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmodata/grafana-hardcharger-datasource.git"
  },
  "homepage": "https://github.com/gizmodata/grafana-hardcharger-datasource",
  "private": true
}
